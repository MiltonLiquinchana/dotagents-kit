/**
 * Función auxiliar para mostrar información de debug del estado Git
 * Útil para troubleshooting cuando hasDirectoryChanges() no funciona como se espera
 */
def debugGitInfo() {
    echo '🐛 === DEBUG: Información Git ==='

    try {
        // Mostrar variables de entorno de Jenkins
        echo '📊 Variables de Jenkins:'
        echo "   GIT_COMMIT: ${env.GIT_COMMIT ?: 'NO DISPONIBLE'}"
        echo "   GIT_PREVIOUS_SUCCESSFUL_COMMIT: ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'NO DISPONIBLE'}"
        echo "   GIT_PREVIOUS_COMMIT: ${env.GIT_PREVIOUS_COMMIT ?: 'NO DISPONIBLE'}"
        echo "   BRANCH_NAME: ${env.BRANCH_NAME ?: 'NO DISPONIBLE'}"

        // Mostrar información básica del repositorio
        echo '📁 Información del repositorio:'
        sh 'git log --oneline -5'

        echo '🌿 Estado actual:'
        sh 'git status --porcelain'
    } catch (Exception e) {
        echo "❌ Error obteniendo información de debug: ${e.getMessage()}"
    }

    echo '🐛 === FIN DEBUG ==='
}

// ============================================================================
// FUNCIONES DE DESPLIEGUE Y ETIQUETADO DOCKER
// ============================================================================

def rutaDeploymentServicio(serviceName, serviceDir) {
    def serviceBaseName = serviceName.endsWith('-service') ?
        serviceName.substring(0, serviceName.lastIndexOf('-service')) :
        serviceName
    return "devops/${env.PIPELINE_CARPETA}/${serviceDir}/deployment-${serviceBaseName}.yaml"
}

/**
 * Función robusta para modificar manifiestos YAML y forzar la inyección
 * de un nuevo tag en la etiqueta 'image' del Deployment. Emplea utilidades
 * clásicas de Shell (sed/awk) garantizando alta compatibilidad entre SOs.
 * 
 * @param serviceName Nombre completo del servicio (incluyendo sub-fijo -service)
 * @param serviceDir Directorio del repositorio de infraestructura
 * @param newTag El nuevo tag calculado dinámicamente que se implantará
 */
def updateDeploymentTag(serviceName, serviceDir, newTag) {
    echo "🔄 Actualizando deployment de ${serviceName} con tag: ${newTag}"

    // 🔑 EXTRAER NOMBRE BASE: Quitar "-service" del final si existe
    def serviceBaseName = serviceName.endsWith('-service') ?
                        serviceName.substring(0, serviceName.lastIndexOf('-service')) :
                        serviceName

    echo "📝 Nombre base extraído: ${serviceBaseName} (desde ${serviceName})"

    // Ruta centralizada para reusar en rollout/diagnóstico.
    def deploymentFile = rutaDeploymentServicio(serviceName, serviceDir)

    echo "📂 Archivo de deployment: ${deploymentFile}"

    // Verificar que el archivo existe
    if (!fileExists(deploymentFile)) {
        error("Deployment no encontrado: ${deploymentFile}; genera o renombra el manifiesto según servicios.py nombres mediante un plan aprobado.")
    }

    // 🔧 MOSTRAR CONTENIDO ANTES DE LA ACTUALIZACIÓN
    echo '📄 Contenido ANTES de la actualización:'
    sh "grep -A1 -B1 'image:' ${deploymentFile}"

    // 🔧 ACTUALIZACIÓN SIMPLE Y DIRECTA
    // Patrón de imagen esperado: "image: <devops.registry>/example-service"
    sh """
        # Hacer backup del archivo original
        cp ${deploymentFile} ${deploymentFile}.backup

        # Actualizar usando el patrón más simple posible
        # Patrón de imagen esperado: "image: <devops.registry>/example-service"
        # Resultado esperado: "image: <devops.registry>/example-service:1.0.40"

        # Opción 1: Reemplazar la línea completa
        sed -i 's|image: <devops.registry>/${serviceName}|image: <devops.registry>/${serviceName}:${newTag}|g' ${deploymentFile}

        echo "✅ Actualización aplicada"
    """

    // 🔧 VERIFICAR QUE LA ACTUALIZACIÓN FUNCIONÓ
    echo '📄 Contenido DESPUÉS de la actualización:'
    sh """
        grep -A1 -B1 'image:' ${deploymentFile}

        # Verificar específicamente si se actualizó correctamente
        if grep -q "<devops.registry>/${serviceName}:${newTag}" ${deploymentFile}; then
            echo ""
            echo "✅ ¡ÉXITO! Tag ${newTag} encontrado en el archivo"
            echo "🎯 Línea actualizada:"
            grep "<devops.registry>/${serviceName}:${newTag}" ${deploymentFile}
        else
            echo ""
            echo "❌ ERROR: Tag ${newTag} NO se encontró"
            echo "🔍 Contenido actual de todas las líneas con 'image:':"
            grep -n 'image:' ${deploymentFile}

            echo ""
            echo "🔧 Intentando método alternativo..."
            # Método alternativo usando awk
            awk '/image: <devops.registry>\\/${serviceName}/ {sub(/image: <devops.registry>\\/${serviceName}/, "image: <devops.registry>/${serviceName}:${newTag}"); print; next} {print}' ${deploymentFile} > ${deploymentFile}.tmp
            mv ${deploymentFile}.tmp ${deploymentFile}

            echo "📄 Resultado del método alternativo:"
            grep "image:" ${deploymentFile}
        fi
    """

    // 🔧 VALIDACIÓN FINAL
    echo '🔍 Validación final:'
    sh """
        if grep -q "<devops.registry>/${serviceName}:${newTag}" ${deploymentFile}; then
            echo "✅ SUCCESS: Deployment actualizado correctamente"
            echo "🎯 Tag final: ${newTag}"

            # Mostrar el diff con el backup
            echo "📊 Diferencias aplicadas:"
            diff ${deploymentFile}.backup ${deploymentFile} || echo "Archivo actualizado exitosamente"

        else
            echo "❌ FAILURE: No se pudo actualizar el deployment"
            echo "🔍 Archivo completo:"
            cat ${deploymentFile}
            return 1
        fi
    """
}

/**
 * Recupera el último tag expuesto remotamente en el Registry (Docker Hub)
 * consumiendo el catálogo del servicio y buscando el patrón más reciente válido.
 * 
 * @param serviceName Nombre exacto del repositorio dentro del namespace (ej: 'example-service')
 * @return String correspondiente al tag cronológicamente más actual o un error si el repo está vacío
 */
def getLatestImageTag(serviceName) {
    def tags = getLatestImageTags(serviceName, '^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9a-f]{7,12})?$', 1)
    return tags ? tags[0] : null
}
/**
 * Operación matemática responsable del versionamiento de Semantic Versioning (SemVer).
 * Divide y parsea el tag (ej. X.Y.Z) y produce el siguiente número de parche (Patch level).
 * Conserva el acarreo decimal existente; admite tags con commit al leer la base.
 * 
 * @param version El tag base sobre el cual realizar el incremento
 * @return El nuevo tag versionado secuencialmente
 */
def incrementVersion(String version) {
    def parts = version.tokenize('-')[0].tokenize('.')
    def major = parts[0].toInteger()
    def minor = parts[1].toInteger()
    def patch = parts[2].toInteger()
    patch += 1
    if (patch > 9) { patch = 0; minor += 1 }
    if (minor > 9) { minor = 0; major += 1 }
    return "${major}.${minor}.${patch}"
}
/**
 * Orquestador principal de conexión API a Docker Hub Registry.
 * Genera llamadas tipo cURL paginadas para encontrar y ordenar etiquetas válidas de
 * un microservicio y retorna la sublista superior.
 * 
 * @param serviceName Nombre del repositorio remoto asociado al namespace logueado.
 * @param tagPattern Expresión regular usada para enmarcar a qué clase de versión apuntar (ej: ramas principales).
 * @param count Limita la carga de datos devuelta del parseo JSON, optimizando memoria (default 5).
 * @return Lista de strings empaquetando ordenadamente los descriptores de versiones remotos.
 */
def getLatestImageTags(serviceName, tagPattern = '^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9a-f]{7,12})?$', count = 5) {
    def baseUrl = "https://registry.hub.docker.com/v2/repositories/<devops.registry>/${serviceName}/tags/"
    def filteredTags = []
    def maxPages = 1000 // Cota de paginación: superar el límite es error, nunca catálogo parcial.
    for (int number = 1; number <= maxPages; number++) {
        def apiUrl = "${baseUrl}?page_size=100&page=${number}"
        def response = sh(script: "curl -sS --connect-timeout 10 --max-time 30 --write-out '\\n%{http_code}' ${shellQuote(apiUrl)}", returnStdout: true)
        def cut = response.lastIndexOf('\n')
        if (cut < 0) error('REGISTRY_FORMATO: falta el status HTTP.')
        def status = response.substring(cut + 1).trim()
        if (status == '404' && number == 1) return [] // Servicio nunca publicado.
        if (status != '200') error("REGISTRY_HTTP: ${status}; no se trata como catálogo vacío.")
        def page = readJSON text: response.substring(0, cut)
        // readJSON convierte el null JSON en un objeto (JSONNull) que no es null para Groovy.
        if (!(page.results instanceof List)) error('REGISTRY_FORMATO: falta results.')
        page.results.each { tag ->
            def name = (tag?.name instanceof String) ? tag.name : null
            if (name && name.matches(tagPattern) && !filteredTags.contains(name)) filteredTags.add(name)
        }
        // No se sigue la URL next: puede tener otro host. Solo indica si avanzar.
        if (!(page.next instanceof String) || !page.next.trim()) break
        if (number == maxPages) error('REGISTRY_PAGINACION: se superó el máximo de páginas.')
    }
    if (!filteredTags) return []
    def ordered = sh(script: "printf '%s' ${shellQuote(filteredTags.join('\n') + '\n')} | LC_ALL=C sort -t. -k1,1nr -k2,2nr -k3,3nr", returnStdout: true).trim().split('\n')
    def result = []
    for (def tag in ordered) {
        if (count > 0 && result.size() >= count) break
        result.add(tag)
    }
    return result
}

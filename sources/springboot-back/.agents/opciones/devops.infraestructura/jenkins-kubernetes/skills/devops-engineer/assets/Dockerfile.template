# Dockerfile para __NOMBRE__
# Solo runtime - Jenkins maneja la construcción
# Actualizado a Java <backend.java> - Skill sync trigger

FROM redhat/ubi10-minimal:latest

# Instalar dependencias necesarias y descargar OpenJDK desde la URL declarada
RUN microdnf install -y curl tar gzip shadow-utils && \
    microdnf clean all && \
    curl -L <devops.jdk_url> | tar -xz -C /opt/

# Configurar JAVA_HOME y PATH
ENV JAVA_HOME=<devops.java_home_contenedor>
ENV PATH=$JAVA_HOME/bin:$PATH

# Crear usuario no-root para seguridad
RUN groupadd --system spring && useradd --system -g spring spring

# Establecer directorio de trabajo
WORKDIR /app

# Copiar el JAR construido por Jenkins
COPY build/libs/__JAR__ app.jar

# Cambiar ownership del archivo
RUN chown spring:spring app.jar

# Cambiar a usuario no-root
USER spring:spring

# Exponer el puerto del servicio
EXPOSE __PUERTO__

# Variables de entorno
ENV JAVA_OPTS="-Xmx512m -Xms256m"
ENV SPRING_PROFILES_ACTIVE=docker

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:__PUERTO____CONTEXT_PATH__/actuator/health || exit 1

# Trigger for Docker stage 224346
# Comando para ejecutar la aplicación
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
